                            <div><h4 class="font-semibold text-lg">Careers</h4><p class="text-sm text-gray-400">Join and grow with us</p></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="nav-item relative py-2">
                <button class="hover:text-gray-500 transition-colors flex items-center gap-1">
                    Projects <i data-lucide="chevron-down" class="w-3 h-3"></i>
                </button>
                <div class="dropdown-menu">
                    <div class="grid grid-cols-3 gap-8">
                        <div class="flex gap-4 cursor-pointer">
                            <div class="w-12 h-12 bg-white rounded-2xl flex items-center justify-center shadow-sm"><i data-lucide="pen-tool" class="w-5 h-5"></i></div>
                            <div><h4 class="font-semibold text-lg">Branding</h4><p class="text-sm text-gray-400">Brands that make impact.</p></div>
                        </div>
                        <div class="flex gap-4 cursor-pointer">
                            <div class="w-12 h-12 bg-white rounded-2xl flex items-center justify-center shadow-sm"><i data-lucide="monitor" class="w-5 h-5"></i></div>
                            <div><h4 class="font-semibold text-lg">Web Design</h4><p class="text-sm text-gray-400">Website that connect.</p></div>
                        </div>
                        <div class="flex gap-4 cursor-pointer">
                            <div class="w-12 h-12 bg-white rounded-2xl flex items-center justify-center shadow-sm"><i data-lucide="layout" class="w-5 h-5"></i></div>
                            <div><h4 class="font-semibold text-lg">UX/UI Design</h4><p class="text-sm text-gray-400">Seamless & intuitive interfaces.</p></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="nav-item relative py-2">
                <button class="hover:text-gray-500 transition-colors flex items-center gap-1">
                    Services <i data-lucide="chevron-down" class="w-3 h-3"></i>
                </button>
                <div class="dropdown-menu">
                    <div class="grid grid-cols-2 gap-8">
                        <div>
                            <a href="../services/index.html" class="bg-[#e6f4f9] rounded-2xl p-4 flex items-center justify-between mb-6 hover:bg-[#d8ecf4] transition-colors">
                                <span class="font-semibold">Services</span>
                                <i data-lucide="arrow-right" class="w-4 h-4"></i>
                            </a>
                            <div class="grid grid-cols-2 gap-6">
                                <div class="flex gap-3"><div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center shadow-sm"><i data-lucide="monitor" class="w-4 h-4"></i></div><div><h5 class="text-sm font-semibold">Web Design</h5></div></div>
                                <div class="flex gap-3"><div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center shadow-sm"><i data-lucide="pen-tool" class="w-4 h-4"></i></div><div><h5 class="text-sm font-semibold">Branding</h5></div></div>
                                <div class="flex gap-3"><div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center shadow-sm"><i data-lucide="layout" class="w-4 h-4"></i></div><div><h5 class="text-sm font-semibold">UX/UI Design</h5></div></div>
                                <div class="flex gap-3"><div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center shadow-sm"><i data-lucide="play" class="w-4 h-4"></i></div><div><h5 class="text-sm font-semibold">Motion Design</h5></div></div>
                            </div>
                        </div>
                        <div>
                            <div class="bg-[#e6e9f9] rounded-2xl p-4 flex items-center justify-between mb-6">
                                <span class="font-semibold">Retainer Services</span>
                                <i data-lucide="arrow-right" class="w-4 h-4"></i>
                            </div>
                            <div class="space-y-4">
                                <div class="flex gap-3"><div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center shadow-sm"><i data-lucide="layers" class="w-4 h-4"></i></div><div><h5 class="text-sm font-semibold">Design Subscription</h5></div></div>
                                <div class="flex gap-3"><div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center shadow-sm"><i data-lucide="users" class="w-4 h-4"></i></div><div><h5 class="text-sm font-semibold">Content Design</h5></div></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <a href="#" class="hover:text-gray-500 transition-colors">For Startups</a>
            <a href="#" class="hover:text-gray-500 transition-colors flex items-center gap-1">Resources <i data-lucide="chevron-down" class="w-3 h-3"></i></a>
        </div>

        <div class="flex items-center gap-4">
            <button class="p-2 hover:bg-gray-100 rounded-full transition-colors">
