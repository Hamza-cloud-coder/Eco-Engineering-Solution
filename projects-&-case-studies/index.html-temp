                            <div><h4 class="font-semibold text-lg">Company</h4><p class="text-sm text-gray-400">Learn more about who we are.</p></div>
                        </div>
                        <div class="flex gap-4 cursor-pointer">
                            <div class="w-12 h-12 bg-white rounded-2xl flex items-center justify-center shadow-sm"><i data-lucide="users" class="w-5 h-5"></i></div>
