    <!-- Hero Section -->
    <section class="pt-40 pb-20 px-6 bg-white">
        <div class="max-w-7xl mx-auto">
            <!-- Top Feature Cards -->
            <div class="flex justify-center mb-24" data-aos="fade-up">
                <div class="bg-[#f4f7f9] rounded-[2rem] p-6 flex flex-col md:flex-row gap-12 shadow-sm">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center shadow-sm"><i data-lucide="pen-tool" class="w-5 h-5"></i></div>
                        <div><h4 class="font-bold text-sm">Branding</h4><p class="text-xs text-gray-400">Brands that make impact.</p></div>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center shadow-sm"><i data-lucide="monitor" class="w-5 h-5"></i></div>
                        <div><h4 class="font-bold text-sm">Web Design</h4><p class="text-xs text-gray-400">Website that connect.</p></div>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center shadow-sm"><i data-lucide="layout" class="w-5 h-5"></i></div>
                        <div><h4 class="font-bold text-sm">UX/UI Design</h4><p class="text-xs text-gray-400">Seamless & intuitive interfaces.</p></div>
                    </div>
                </div>
            </div>

            <div class="text-center max-w-4xl mx-auto">
                <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-12 leading-tight" data-aos="fade-up">Good design looks nice, but great design solves a problem.</h1>
                <p class="text-gray-500 text-sm uppercase tracking-widest mb-12" data-aos="fade-up" data-aos-delay="200">See the problems that we solved</p>
                <div class="flex justify-center" data-aos="fade-up" data-aos-delay="400">
                    <div class="w-10 h-10 bg-black rounded-full flex items-center justify-center text-white animate-bounce">
                        <i data-lucide="arrow-down" class="w-5 h-5"></i>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Project Filter & Grid -->
    <section class="py-24 px-6 bg-white">
        <div class="max-w-7xl mx-auto">
            <!-- Filter Bar -->
            <div class="flex flex-col md:flex-row justify-between items-center mb-16 gap-8">
                <div class="flex items-center gap-2 text-sm text-gray-500 uppercase tracking-widest" data-aos="fade-up">
                    <span class="text-black">•</span> Our projects
                </div>
                <div class="flex items-center gap-4 bg-[#f3f4f6] p-1.5 rounded-full" data-aos="fade-up">
                    <button class="filter-btn active">Web Design</button>
                    <button class="filter-btn">Branding</button>
                    <button class="filter-btn">UX/UI</button>
                    <button class="filter-btn">Motion Design</button>
                </div>
                <div class="flex items-center gap-2" data-aos="fade-up">
                    <button class="w-10 h-10 bg-black text-white rounded-lg flex items-center justify-center"><i data-lucide="grid" class="w-5 h-5"></i></button>
                    <button class="w-10 h-10 bg-white border border-gray-200 rounded-lg flex items-center justify-center hover:bg-gray-50 transition-colors"><i data-lucide="list" class="w-5 h-5"></i></button>
                </div>
            </div>

            <!-- Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                <!-- Project 1 -->
                <div class="project-card" data-aos="fade-up">
                    <div class="rounded-[2.5rem] overflow-hidden mb-8 aspect-[4/3] bg-[#f4f5f9]">
                        <img src="https://picsum.photos/seed/ritemedia/800/600" alt="RiTE Media" class="w-full h-full object-cover transition-transform duration-700">
                    </div>
                    <div class="flex items-center justify-between">
                        <h3 class="text-3xl font-bold">RiTE Media - 2026</h3>
                        <div class="flex gap-2">
                            <span class="px-4 py-1.5 rounded-full border border-gray-200 text-xs font-medium text-gray-500">Web Design</span>
                            <span class="px-4 py-1.5 rounded-full border border-gray-200 text-xs font-medium text-gray-500">Webflow Dev</span>
                        </div>
                    </div>
                </div>
                <!-- Project 2 -->
                <div class="project-card" data-aos="fade-up" data-aos-delay="200">
                    <div class="rounded-[2.5rem] overflow-hidden mb-8 aspect-[4/3] bg-[#f4f5f9]">
                        <img src="https://picsum.photos/seed/fluxo/800/600" alt="Fluxo" class="w-full h-full object-cover transition-transform duration-700">
                    </div>
                    <div class="flex items-center justify-between">
                        <h3 class="text-3xl font-bold">Fluxo - 2026</h3>
                        <div class="flex gap-2">
                            <span class="px-4 py-1.5 rounded-full border border-gray-200 text-xs font-medium text-gray-500">Web Design</span>
                            <span class="px-4 py-1.5 rounded-full border border-gray-200 text-xs font-medium text-gray-500">Branding</span>
                        </div>
                    </div>
                </div>
                <!-- Project 3 -->
                <div class="project-card" data-aos="fade-up">
                    <div class="rounded-[2.5rem] overflow-hidden mb-8 aspect-[4/3] bg-[#f4f5f9]">
                        <img src="https://picsum.photos/seed/vyvo/800/600" alt="Vyvo" class="w-full h-full object-cover transition-transform duration-700">
                    </div>
                    <div class="flex items-center justify-between">
                        <h3 class="text-3xl font-bold">Vyvo - 2025</h3>
                        <div class="flex gap-2">
                            <span class="px-4 py-1.5 rounded-full border border-gray-200 text-xs font-medium text-gray-500">Content Creation</span>
                            <span class="px-4 py-1.5 rounded-full border border-gray-200 text-xs font-medium text-gray-500">Webflow Dev</span>
                            <span class="px-4 py-1.5 rounded-full border border-gray-200 text-xs font-medium text-gray-500">Web Design</span>
                        </div>
                    </div>
                </div>
                <!-- Project 4 -->
                <div class="project-card" data-aos="fade-up" data-aos-delay="200">
                    <div class="rounded-[2.5rem] overflow-hidden mb-8 aspect-[4/3] bg-[#f4f5f9]">
                        <img src="https://picsum.photos/seed/saakinun/800/600" alt="SAAKINUN" class="w-full h-full object-cover transition-transform duration-700">
                    </div>
                    <div class="flex items-center justify-between">
                        <h3 class="text-3xl font-bold">SAAKINUN - 2025</h3>
                        <div class="flex gap-2">
                            <span class="px-4 py-1.5 rounded-full border border-gray-200 text-xs font-medium text-gray-500">Web Design</span>
                            <span class="px-4 py-1.5 rounded-full border border-gray-200 text-xs font-medium text-gray-500">Webflow Dev</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center mt-20">
                <button class="btn-black">Show more</button>
            </div>
        </div>
    </section>

    <!-- Contact Form -->
    <section class="py-24 px-6 bg-[#f4f5f9]">
        <div class="max-w-7xl mx-auto bg-white rounded-[3rem] p-12 md:p-20 shadow-sm" data-aos="fade-up">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-20">
                <div>
                    <div class="flex items-center gap-2 text-sm text-gray-500 uppercase tracking-widest mb-8">
                        <span class="text-black">•</span> We're explorers
                    </div>
                    <div class="inline-block px-4 py-1.5 rounded-full border border-gray-200 text-xs font-medium text-gray-400 mb-8">Contact us</div>
                    <h2 class="text-6xl md:text-7xl font-bold mb-12 leading-tight">Let's make <br> an impact</h2>
                    
                    <div class="mt-20">
                        <div class="flex items-center gap-4 mb-8">
                            <div class="w-12 h-12 bg-black rounded-xl flex items-center justify-center text-white"><i data-lucide="dribbble" class="w-6 h-6"></i></div>
                            <span class="font-bold">Dribbble SELECT</span>
                        </div>
                        <p class="text-gray-400 font-medium mb-4 uppercase tracking-widest text-xs">Our Testimonials:</p>
                        <div class="flex gap-4">
                            <div class="w-10 h-10 rounded-full border border-gray-200 flex items-center justify-center"><i data-lucide="chevron-left" class="w-5 h-5"></i></div>
                            <div class="w-10 h-10 rounded-full border border-gray-200 flex items-center justify-center"><i data-lucide="chevron-right" class="w-5 h-5"></i></div>
                        </div>
                    </div>
                </div>

                <div class="space-y-12">
                    <h3 class="text-2xl font-bold">Ready to take next step with us?</h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="space-y-2">
                            <label class="text-xs font-bold uppercase tracking-widest text-gray-400">Name</label>
                            <input type="text" placeholder="Evan" class="contact-input">
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-bold uppercase tracking-widest text-gray-400">Company</label>
                            <input type="text" placeholder="Microsoft" class="contact-input">
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-bold uppercase tracking-widest text-gray-400">Your Email</label>
                            <input type="email" placeholder="evan@microsoft.com" class="contact-input">
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-bold uppercase tracking-widest text-gray-400">Your Phone</label>
                            <input type="tel" placeholder="Your number phone" class="contact-input">
                        </div>
                    </div>

                    <div class="space-y-6">
                        <label class="text-xs font-bold uppercase tracking-widest text-gray-400">I'm interested in...</label>
                        <div class="flex flex-wrap gap-3">
                            <button class="tag-btn">Branding</button>
                            <button class="tag-btn active">Website Design</button>
                            <button class="tag-btn">UX/UI</button>
                            <button class="tag-btn">Motion Design</button>
                            <button class="tag-btn">Landing page</button>
                            <button class="tag-btn">Content Creation</button>
                            <button class="tag-btn">Webflow Development</button>
                        </div>
                    </div>

                    <div class="space-y-6">
                        <label class="text-xs font-bold uppercase tracking-widest text-gray-400">Project Budget (USD)</label>
                        <div class="flex flex-wrap gap-3">
                            <button class="tag-btn">Free</button>
                            <button class="tag-btn active">≤ $10k</button>
                            <button class="tag-btn">> $10k</button>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-xs font-bold uppercase tracking-widest text-gray-400">Tell us about your project.</label>
                        <textarea placeholder="Write something concise..." class="contact-input resize-none h-32"></textarea>
                    </div>

                    <div class="flex items-center gap-4 bg-gray-50 p-4 rounded-xl border border-gray-100">
                        <input type="checkbox" id="robot" class="w-6 h-6 rounded border-gray-300">
                        <label for="robot" class="text-sm font-medium">I'm not a robot</label>
                        <div class="ml-auto text-[10px] text-gray-400 text-right">reCAPTCHA <br> Privacy - Terms</div>
                    </div>

                    <button class="w-full bg-black text-white py-5 rounded-2xl font-bold text-lg hover:bg-gray-800 transition-all">Submit</button>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-[#f4f5f9] pt-24 pb-12 px-6">
        <div class="max-w-7xl mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-20">
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-widest text-gray-400 mb-8 flex items-center gap-2">
